# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments
/.venv/
.env
.env.*

# Large artifacts staged into the repo, never committed. Expected paths and hashes
# are documented in docs/CHECKPOINTS.md.
/checkpoints/
/data/
*.pth
*.pt
*.ckpt
*.pkl
*.h5
*.hdf5
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.mp4

# Run outputs. Bulk planner dumps stay local; held-out per-episode records needed to
# regenerate continuous leaderboard columns are tracked (see docs/EVAL_RECORDS.md).
/eval_outputs/**
!/eval_outputs/
!/eval_outputs/*/
!/eval_outputs/*/*/
!/eval_outputs/*/*/test100/
!/eval_outputs/*/*/test200/
!/eval_outputs/*/*/test300/
!/eval_outputs/*/*/test*/**/
/eval_outputs/*/*/test*/**/*
!/eval_outputs/*/*/test*/**/
!/eval_outputs/*/*/test*/**/episodes.jsonl

/logs/
/outputs/
/multirun/
/plan_outputs*/
.hydra/
wandb/
*.log
nohup.out

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
